    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "muv",
    "magvarupdate",
    "tavern",
    "variable-table"
  ],
  "license": "PolyForm-Noncommercial-Copyleft-1.0.0",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "repository": {"type": "git", "url": "git+https://github.com/chen731215-dev/dsh-muv-table.git"},`n  "engines": {
    "node": ">=20"
  }
}