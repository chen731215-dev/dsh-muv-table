{
  "name": "dsh-muv-table",
  "version": "0.3.0",
  "description": "MUV 变量表格编辑器 —— 树形变量面板、宏测试浮窗（random/pick/roll）、骰子快捷栏、pick 缓存管理；支持直接读取 SillyTavern PNG 角色卡（含正则脚本、世界书、变量表）。dsh-muv-engine 的伴生插件",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./lib/*": "./lib/*",
    "./package.json": "./package.json"
  },
  "files": ["lib", "cordis.patch.yml", "CHANGELOG.md", "README.md", "test-cards.mjs", "test-png-card.mjs", "test-muv-parser.mjs", "test-preset-resolve.mjs", "test-card-ops.mjs", "test-var-section.mjs"],
  "keywords": ["dsh", "dsh-plugin", "deepseek-harness", "muv", "magvarupdate", "tavern", "variable-table"],
  "license": "PolyForm-Noncommercial-Copyleft-1.0.0",
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web" }
  },
  "repository": {"type": "git", "url": "git+https://github.com/chen731215-dev/dsh-muv-table.git"},
  "engines": { "node": ">=20" },
  "scripts": {
    "test": "node test-var-section.mjs"
  }
}